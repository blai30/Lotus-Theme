<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.blai30.lotus.theme</id>
    <name>Lotus Theme</name>
    <vendor url="https://www.bhlai.com">Brian Lai</vendor>

    <description><![CDATA[
        <p>Soft pastel syntax colors on calm dark and light backgrounds, in two themes:</p>
        <ul>
            <li><b>Lotus Dark</b></li>
            <li><b>Lotus Light</b></li>
        </ul>
        <p>Both themes are built on the Islands UI and include editor colors for <a href="https://plugins.jetbrains.com/plugin/10080-rainbow-brackets">Rainbow Brackets</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="c3f84cf4-72fb-49ac-bd03-9f47a41115a4" path="/themes/Lotus_Dark.theme.json"/>
        <themeProvider id="40b6d5e5-c8b1-4d60-bcb1-c3a747c1d46b" path="/themes/Lotus_Light.theme.json"/>
    </extensions>
</idea-plugin>
